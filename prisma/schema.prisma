// PulseCheck Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  password            String?  // Hashed password (null for OAuth users)
  name                String
  role                Role     @default(DEVELOPER)
  avatarUrl           String?
  onboardingCompleted Boolean  @default(false)
  slackUserId         String?  // Linked Slack user ID
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  statusUpdates   StatusUpdate[]
  views           View[]
  teamMemberships TeamMembership[]
}

model StatusUpdate {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id])

  // Raw input
  rawTranscript  String

  // AI-extracted structured data (stored as JSON string)
  completed      String   @default("[]") // JSON array
  inProgress     String   @default("[]") // JSON array
  blockers       String   @default("[]") // JSON array
  needsHelp      String   @default("[]") // JSON array
  sentiment      String?
  riskFlags      String   @default("[]") // JSON array

  // AI-generated summary
  summary        String?

  createdAt      DateTime @default(now())
}

enum Role {
  DEVELOPER
  TESTER
  MANAGER
  LEAD
}

// Team structure
model Team {
  id          String           @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  memberships    TeamMembership[]
  settings       TeamSettings?
  views          View[]
  statusUpdates  StatusUpdate[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
}

enum TeamRole {
  MEMBER  // Regular team member
  LEAD    // Team lead - can manage team settings
  MANAGER // Manager - can oversee team, view reports
}

model TeamSettings {
  id              String   @id @default(cuid())
  teamId          String   @unique
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reminderTime    String   @default("16:00")        // When to send reminders
  reminderDays    String   @default("[1,2,3,4,5]")  // Days of week (Mon-Fri)
  digestEnabled   Boolean  @default(true)
  digestSchedule  String   @default("daily")        // daily, weekly
  digestTime      String   @default("09:00")        // When to send digest
  timezone        String   @default("UTC")
  slackChannelId  String?  // Slack channel for digests
  slackWebhookUrl String?  // Incoming webhook for posting
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model View {
  id          String       @id @default(cuid())
  name        String
  description String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  columns     ViewColumn[]
  items       WorkItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ViewColumn {
  id        String   @id @default(cuid())
  viewId    String
  view      View     @relation(fields: [viewId], references: [id], onDelete: Cascade)
  name      String
  type      String   // text, number, date, url, select, person
  options   String   @default("[]") // JSON for select options
  isSystem  Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
}

model WorkItem {
  id        String   @id @default(cuid())
  viewId    String
  view      View     @relation(fields: [viewId], references: [id], onDelete: Cascade)
  values    String   @default("{}") // JSON: {columnId: value}
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Password reset tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// Slack workspace installation
model SlackInstallation {
  id              String   @id @default(cuid())
  teamId          String   // Slack team/workspace ID
  teamName        String
  botToken        String   // Bot OAuth token
  botUserId       String
  installedBy     String   // Slack user ID who installed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([teamId])
}
